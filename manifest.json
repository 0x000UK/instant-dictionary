{
  "manifest_version": 2,
  "name": "Instant Dictionary",
  "version": "1.0.0",
  "description": "Double-click or select any word, phrase, or idiom to see its definition instantly.",
  "author": "UK",
  "homepage_url": "https://github.com/0x000UK",

  "permissions": [
    "activeTab",
    "<all_urls>"
  ],

  "icons": {
    "512": "icons/icon.png"
  },

  "browser_action": {
    "default_icon": "icons/icon.png",
    "default_title": "Instant Dictionary"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "content_security_policy": "default-src 'none'; script-src 'self'; connect-src https://api.dictionaryapi.dev https://en.wiktionary.org; style-src 'self'; media-src https:;",

  "browser_specific_settings": {
    "gecko": {
      "id": "itsutkarshk711@gmail.com",
      "strict_min_version": "109.0",
      "update_url": "https://github.com/0x000UK/instant-dictionary.xpi"
    }
  }
}
